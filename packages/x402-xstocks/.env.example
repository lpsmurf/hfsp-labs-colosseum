# Sumsub sandbox credentials (sbx: prefix required)
SUMSUB_APP_TOKEN=sbx:...
SUMSUB_SECRET_KEY=...
SUMSUB_WEBHOOK_SECRET=...   # separate from app secret — set in dashboard

# Sumsub level to use for xStocks KYC
SUMSUB_LEVEL_NAME=id-and-liveness

# xChange (Backed) API — get from Settings → API in the Backed client app (app.backed.fi)
# Must register your Solana wallet in Backed before quotes will succeed
BACKED_API_KEY=
# Solana RPC for ATA checks / on-chain validation (mainnet or devnet)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Server
PORT=3014
NODE_ENV=development
