PORT=3008
NODE_ENV=development

# ── Base (EVM) payment ────────────────────────────────────────────────────────
BASE_RPC_URL=https://mainnet.base.org
PAYMENT_RECIPIENT_BASE=0xYOUR_EVM_WALLET_ADDRESS

# ── Solana payment ────────────────────────────────────────────────────────────
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
PAYMENT_RECIPIENT_SOL=YOUR_SOLANA_WALLET_BASE58

# ── GitHub — optional, raises rate limit from 60 to 5000 req/hr ──────────────
GITHUB_TOKEN=github_pat_your_fine_grained_token

# ── ACE Data Cloud — optional, enables AI feedback on findings ────────────────
ACEDATA_API_KEY=your_acedata_api_key
ACEDATA_FACILITATOR_ADDRESS=0xYOUR_FACILITATOR_ADDRESS

# ── AI detection pass — optional, but it is the only engine that reaches logic bugs ──
# Pattern rules top out around 18% of real audit findings; 81% are accounting and
# protocol-logic bugs that need reading the code. This pass does that.
# Anthropic is preferred when set; ACE Data Cloud above is the fallback transport.
ANTHROPIC_API_KEY=
AI_DETECT_MODEL=claude-sonnet-5
AI_DETECT_MODEL_FALLBACK=gpt-4o
# Source characters sent per audit (~160k chars is roughly 40k tokens).
AI_DETECT_CHAR_BUDGET=160000
