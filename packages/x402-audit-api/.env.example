PORT=3008
NODE_ENV=development

# Base RPC for payment verification
BASE_RPC_URL=https://mainnet.base.org

# Receives the $0.99 USDC audit fee on Base
PAYMENT_RECIPIENT=0xYOUR_WALLET_ADDRESS

# GitHub token — higher rate limits (5000 req/hr vs 60), optional
GITHUB_TOKEN=ghp_your_token_here

# ACE Data Cloud — OpenAI gpt-4o-mini via x402 for AI feedback, optional
ACEDATA_API_KEY=your_acedata_api_key
ACEDATA_FACILITATOR_ADDRESS=0xYOUR_FACILITATOR_ADDRESS
