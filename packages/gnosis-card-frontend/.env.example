# Backend API base. Leave empty to use the Vite dev proxy (→ http://localhost:3001).
# In production set to the deployed gnosis-card-x402 origin, e.g. https://card.hfsp.cloud
VITE_API_BASE=

# During dev, where the Vite proxy forwards /api requests:
VITE_API_TARGET=http://localhost:3001

# Solana RPC used to fetch a recent blockhash before Phantom broadcasts.
# A Helius/QuickNode URL is recommended for reliability.
VITE_SOLANA_RPC=https://api.mainnet-beta.solana.com

# Base RPC (optional override).
VITE_BASE_RPC=https://mainnet.base.org
