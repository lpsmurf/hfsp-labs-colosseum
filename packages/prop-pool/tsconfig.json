{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": ["scripts/**/*.ts", "src/**/*.ts", "crank/**/*.ts", "bot/**/*.ts", "tests/**/*.ts", "*.ts"],
  "exclude": ["miniapp", "node_modules", "target"]
}
