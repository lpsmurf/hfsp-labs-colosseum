# ── Solana (devnet only) ──────────────────────────────────────────────────────
SOLANA_RPC_URL=https://api.devnet.solana.com

# ── TxLINE (TxODDS) devnet API ────────────────────────────────────────────────
# Auth is handled by the vendored SDK (guest -> subscribe -> activate) and cached
# in .m0-cache.json; these are only needed if you drive the API manually.
TXLINE_BASE_URL=https://txline-dev.txodds.com

# ── Settlement crank ──────────────────────────────────────────────────────────
# Defaults to .devnet-wallet.json; override with a base58 secret if you prefer.
# CRANK_WALLET_SECRET_KEY=
CRANK_POLL_INTERVAL_SECONDS=30
CRANK_COMPUTE_UNITS=1400000

# ── Telegram bot (M3) ─────────────────────────────────────────────────────────
# Create a bot with @BotFather and paste the token here. Register MINIAPP_URL via
# /setmenubutton (must be HTTPS). The bot never holds keys.
TELEGRAM_BOT_TOKEN=
MINIAPP_URL=https://your-miniapp-host.example.com
# Devnet stake mint (default: Circle devnet USDC).
STAKE_MINT=Gh9ZwEmdLJ8DscKNTkTqPbNwLNNBjuSzaG9Vp2KGtKJr
