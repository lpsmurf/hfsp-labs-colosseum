# shopping-agent — env template. Copy to .env (gitignored) and fill in to go live.
# Every value is OPTIONAL for `npm run demo` (it dry-runs without keys).

# ── Agent wallet (Solana) ────────────────────────────────────────────────────
# bs58-encoded secret key. This ONE wallet self-funds inference (BlockRun) AND
# signs purchase payments (Crossmint). Top it up with USDC to fund the agent.
SOLANA_WALLET_KEY=
# Solana RPC — Helius recommended for fast x402 verification + tx submission.
HELIUS_RPC_URL=

# ── AgentMail (the agent's own email) ────────────────────────────────────────
# https://console.agentmail.to  →  API key. Base: https://api.agentmail.to/v0
AGENTMAIL_API_KEY=

# ── BlockRun (self-funding LLM over x402) ────────────────────────────────────
# No API key — inference is paid per-request from SOLANA_WALLET_KEY above.
# Install to enable live calls:  npm i @blockrun/llm
# (optional) pin a default model id, e.g. anthropic/claude-haiku-4.5
BLOCKRUN_DEFAULT_MODEL=

# ── Keepa (price monitoring) ─────────────────────────────────────────────────
# https://keepa.com/#!api  →  64-char key. Token-bucket rate limited.
KEEPA_API_KEY=

# ── Crossmint (Amazon crypto checkout) ───────────────────────────────────────
# https://console.crossmint.com  →  SERVER-SIDE key with scopes:
#   orders.create, orders.read, orders.update
# Start in staging; flip CROSSMINT_ENV=production for mainnet.
CROSSMINT_API_KEY=
CROSSMINT_ENV=staging

# ── Telegram (reused from clawdrop-agent-runtime) ────────────────────────────
TELEGRAM_BOT_TOKEN=

# ── Spend guardrails (autonomous-spend caps, USD) ────────────────────────────
SPEND_PER_TX_USD=200
SPEND_DAILY_USD=500
SPEND_HUMAN_CONFIRM_USD=100
SPEND_LOW_BALANCE_ALERT_USD=10
