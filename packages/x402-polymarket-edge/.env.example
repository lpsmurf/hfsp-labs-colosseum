# ── Server ────────────────────────────────────────────────────────────────────
PORT=3016
NODE_ENV=development

# ── x402 payment (per /edges query) ─────────────────────────────────────────────
# Solana wallet that receives the USDC query fee.
PAYMENT_RECIPIENT_SOL=YOUR_SOLANA_WALLET_BASE58
# Helius (or any) Solana RPC used to verify the payment tx.
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# Price per /edges query in micro-USDC (5000 = $0.005).
PRICE_PER_CALL=5000

# ── Data sources ────────────────────────────────────────────────────────────────
GAMMA_API_URL=https://gamma-api.polymarket.com
CLOB_API_URL=https://clob.polymarket.com
# Sharp odds provider (Pinnacle fair value). Get a key at oddspapi.io.
ODDS_API_BASE=https://api.oddspapi.io/v4
ODDS_API_KEY=

# ── Edge universe + costs (mirror polysharp defaults) ───────────────────────────
MAX_DAYS_TO_RESOLVE=7
MIN_LIQUIDITY_USD=5000
MAX_SPREAD=0.04
MIN_EDGE=0.03
TAKER_FEE=0
EST_SLIPPAGE=0.01
SAFETY_MARGIN=0.01

# ── Sizing (fractional Kelly) ───────────────────────────────────────────────────
BANKROLL_USD=1000
KELLY_FRACTION=0.25
MAX_POSITION_PCT=0.05
