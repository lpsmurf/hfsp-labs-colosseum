# Public base URL — load-bearing for x402 realm and MPP memo prefix
BASE_URL=https://vpn-base.hfsp.cloud

# Operator wallet — RECIPIENT only, no private keys here.
# This Base address receives all x402 USDC payments.
OPERATOR_BASE_ADDRESS=0xaF4991538332E3A037EF457BC635f0757ad61149

# x402 facilitator — verifies Base USDC payments on-chain
FACILITATOR_URL=https://x402.org/facilitator

# Hetzner Cloud — provision VPN and VPS servers (required — app will not start without this)
HETZNER_API_TOKEN=

# Redis — lease expiry tracking + MPP nonce store
REDIS_URL=redis://localhost:6379

# ── MPP (Machine Payments Protocol) ───────────────────────────────────────────
# Optional — set all three to enable MPP alongside x402.
# Agents using Tempo chain (MPP) can pay in addition to Base USDC (x402).
#
# MPP keys (Machine Payments Protocol)
# NOTE: These example values are placeholders. DO NOT use literal values from this file.
# Generate a secure secret for MPP_SECRET_KEY (32 bytes hex) and valid EVM private keys
# for MPP_OPERATOR_KEY / MPP_FEE_PAYER_KEY before enabling MPP in production.
# Example placeholder values below:
MPP_SECRET_KEY=<insert-your-32-byte-hex-secret-here>
MPP_OPERATOR_KEY=<insert-your-evm-private-key-here>
MPP_FEE_PAYER_KEY=<insert-your-evm-private-key-here>
#
# Tempo RPC (defaults to public endpoint — no key needed)
# TEMPO_RPC_URL=https://rpc.tempo.xyz

# Server
PORT=3002
NODE_ENV=production
DEV_MODE=false   # true = Base Sepolia testnet + 1hr auto-destroy
