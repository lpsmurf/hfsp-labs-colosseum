# x402-store — Solana Cryptorefills proxy with commission
# Copy to .env and fill in real values before running.

# Your Solana wallet public key — agents send USDC here
OPERATOR_SOLANA_ADDRESS=

# Your Solana wallet private key (base58) — used to pay Cryptorefills
# NEVER commit this. Keep in a secrets manager in production.
STORE_SOLANA_PRIVATE_KEY=

# Helius RPC URL with your API key
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY_HERE

# Commission added on top of Cryptorefills price (0.05 = 5%)
COMMISSION_RATE=0.025

# Optional: Solana RPC for blockhash fetching. Defaults to HELIUS_RPC_URL if unset.
# SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY_HERE

# Redis for replay protection
REDIS_URL=redis://localhost:6379

PORT=3002
NODE_ENV=production

# Cryptorefills x402 host (default is fine)
CR_HOST=https://x402.cryptorefills.com

# Whitelisted agent wallets — pay $0.0001 for testing (comma-separated, leave empty in prod)
AGENT_WALLETS=
