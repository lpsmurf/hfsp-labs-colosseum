# Required — Solana wallet that receives USDC payments
WALLET_PUBLIC_KEY=your_solana_wallet_public_key
WALLET_PRIVATE_KEY_HEX=your_64_byte_private_key_as_hex

# Optional — override defaults
API_PORT=8792
PROXY_PORT=8793
DATABASE_PATH=./data/vpn.db

# Public hostname shown in proxy connection instructions
# If running on a server, set this to your domain or IP
PUBLIC_HOST=vpn.clawdrop.live

# Helius RPC for payment verification
HELIUS_API_KEY=b72c1253-4c5d-441b-8b54-46b08d10d447

# SAP marketplace base URL (shown in registration)
AGENT_BASE_URL=https://vpn.clawdrop.live
