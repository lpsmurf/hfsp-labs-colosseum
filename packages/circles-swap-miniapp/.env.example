# Solana deposit address shown in "Sol → Gnosis" quotes (your gnosis-card-x402 wallet)
VITE_BRIDGE_SOL_WALLET=<your-solana-wallet-pubkey>

# gnosis-card-x402 backend URL (defaults to /api proxy via vite)
# VITE_API_BASE=http://localhost:3001

# Override if your backend isn't behind the same domain
# VITE_API_BASE=https://clawdrop.live/gnosis-api
