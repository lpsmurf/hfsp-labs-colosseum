# Operator wallet — RECIPIENT only, no private keys here.
# This Solana address receives all USDC payments.
OPERATOR_SOLANA_ADDRESS=GdAWRcvrVabFi6QtciGJNYsS8cykJkZTNZ3cFea6ywfY

# Hetzner Cloud — provision VPN and VPS servers (required — app will not start without this)
HETZNER_API_TOKEN=

# Helius RPC — fast Solana mainnet RPC for tx verification and payment confirmation
# Get a free key at https://helius.dev — the public endpoint throttles under load
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY

# Redis — lease expiry tracking
REDIS_URL=redis://localhost:6379

# Agent wallets — comma-separated Solana addresses that pay micro-price ($0.0001)
# instead of the full tier price, for full real provisioning. Safe for our own agents.
AGENT_WALLETS=FEuTewmn9RdwexQnhvkCq7VaXfpnQL9qsYrTrCgTtk5e,5kYtExAmplEAddressExample2AbCdEfGh

# Server
PORT=3001
NODE_ENV=production
DEV_MODE=false   # true = skip payment verification + 1hr auto-destroy (local dev only)
