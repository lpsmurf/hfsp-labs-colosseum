# Solana wallet that receives x402 USDC payments
PAYMENT_RECIPIENT_SOL=YOUR_SOLANA_WALLET_BASE58

# Helius RPC — fast tx verification (free tier at helius.dev)
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# Price per request in micro-USDC (1_000 = $0.001)
PRICE_PER_CALL=5000

PORT=3015
NODE_ENV=development
