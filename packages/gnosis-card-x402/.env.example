# ── Solana wallet (receives x402 USDC + signs bridge txs) ─────────────────────
WALLET_PUBLIC_KEY=your_solana_wallet_pubkey
WALLET_PRIVATE_KEY=your_solana_wallet_private_key_base58

# Helius RPC for payment verification
HELIUS_API_KEY=your_helius_api_key

#── Redis for nullifier store (prevents double-spending) ───────────────────────
REDIS_URL=redis://localhost:6379

# ── Gnosis Pay partner credentials ────────────────────────────────────────────
# Register at: https://partners.gnosispay.com
GP_PARTNER_ID=gp_your_partner_id
GP_APP_ID=gp_your_app_id
GP_API_URL=https://api.gnosispay.com

# ── deBridge DLN bridge ────────────────────────────────────────────────────────
# No API key required — public API
DBRIDGE_API_URL=https://api.dln.trade/v1.0

# ── Pricing ────────────────────────────────────────────────────────────────────
TOPUP_FEE_PCT=0.5      # % service fee on top-up (default 0.5%)
ONBOARD_FEE_USDC=5     # flat fee for managed onboarding (default $5 USDC)

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production
