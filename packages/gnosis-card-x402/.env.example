# ── Solana wallet (receives x402 USDC + signs bridge txs) ─────────────────────
WALLET_PUBLIC_KEY=your_solana_wallet_pubkey
WALLET_PRIVATE_KEY=your_solana_wallet_private_key_base58

# ── EVM wallet (receives Base USDC + signs Gnosis bridge txs) ─────────────────
EVM_WALLET_ADDRESS=0xYourEvmAddress
EVM_WALLET_PRIVATE_KEY=your_evm_private_key_hex
BASE_RPC_URL=https://mainnet.base.org

# ── Helius RPC for payment verification ───────────────────────────────────────
HELIUS_API_KEY=your_helius_api_key

# ── Redis for nullifier store (prevents double-spending) ──────────────────────
REDIS_URL=redis://localhost:6379

# ── Gnosis Pay partner credentials ────────────────────────────────────────────
GP_PARTNER_ID=
GP_APP_ID=
GP_API_URL=https://api.gnosispay.com

# ── Relay.link bridge ─────────────────────────────────────────────────────────
RELAY_API_URL=https://api.relay.link

# ── Pricing ───────────────────────────────────────────────────────────────────
TOPUP_FEE_PCT=0.5
ONBOARD_FEE_USDC=5

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3002
NODE_ENV=production
