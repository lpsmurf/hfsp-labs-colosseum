PORT=3007
NODE_ENV=development

# Base RPC
BASE_RPC_URL=https://mainnet.base.org

# DonationRouter contract — deployed on Base
ROUTER_CONTRACT_ADDRESS=0xYOUR_ROUTER_CONTRACT

# EOA that calls route() — must match the `router` param at deploy time
ROUTER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_64_CHARS

# Treasury wallet that receives the 3% fee
TREASURY_ADDRESS=0xYOUR_TREASURY_ADDRESS
