[0.000, "o", "\u001b[38;5;117m\u001b[1m▶ Each agent is registered on-chain with SAP\u001b[0m\r\n"]
[0.410, "o", "\r\n"]
[0.000, "o", "\u001b[38;5;220m  SAP Agent PDA:\u001b[0m \u001b[97m\u001b[1m8m5MXkunTGabXKLrmVCj2WekLF4V2WwB3gKGuAc872rx\u001b[0m\r\n"]
[0.000, "o", "\u001b[2m  Explorer: https://explorer.oobeprotocol.ai/agent/8m5MXkunTGabXKLrmVCj2WekLF4V2WwB3gKGuAc872rx\u001b[0m\r\n\r\n"]
[0.000, "o", "\u001b[2m  SAP enables any AI client to discover these agents, their capabilities,\u001b[0m\r\n"]
[0.000, "o", "\u001b[2m  endpoints, and payment requirements — without prior configuration.\u001b[0m\r\n"]
[2.008, "o", "\r\n"]
[0.000, "o", "\u001b[38;5;99m\u001b[1m╔══════════════════════════════════════════════════════════════════╗\u001b[0m\r\n"]
[0.002, "o", "\u001b[38;5;99m\u001b[1m║  STEP 3 — How Payments Work (x402 Protocol)                     ║\u001b[0m\r\n"]
[0.000, "o", "\u001b[38;5;99m\u001b[1m╚══════════════════════════════════════════════════════════════════╝\u001b[0m\r\n\r\n"]
[0.000, "o", "\u001b[38;5;117m\u001b[1m▶ First, the agent calls an Ace Data Cloud endpoint WITHOUT a payment header\u001b[0m\r\n"]
[0.413, "o", "\u001b[38;5;75m\u001b[1m  $ curl -s https://api.acedata.cloud/v1/search -H 'Content-Type: application/json'\u001b[0m\r\n"]
[0.610, "o", "\r\n\u001b[38;5;214m  HTTP 402 Payment Required\u001b[0m\r\n"]
[0.000, "o", "  {\r\n    \"x402Version\": 1,\r\n    \"error\": \"Payment required\",\r\n    \"accepts\": [{\r\n      \"scheme\": \"exact\",\r\n      \"network\": \"solana-mainnet\",\r\n      \"maxAmountRequired\": \"10000\",\r\n      \"asset\": \"EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v\",\r\n      \"payTo\": \"AceDataCloud...wallet\",\r\n      \"description\": \"Ace Data Cloud Search API — per-call USDC\"\r\n    }]\r\n  }\r\n"]
[1.509, "o", "\r\n"]
[0.000, "o", "\u001b[38;5;117m\u001b[1m▶ The agent reads the 402 → sends USDC on Solana → retries with X-Payment header\u001b[0m\r\n"]
[0.414, "o", "\r\n"]
[0.000, "o", "\u001b[2m  Payment flow (automated, no human interaction):\u001b[0m\r\n"]
[0.000, "o", "\r\n"]
[0.000, "o", "  \u001b[38;5;117m1.\u001b[0m Agent detects 402 response from Ace Data Cloud\r\n"]
[0.000, "o", "  \u001b[38;5;117m2.\u001b[0m SDK reads \u001b[97mmaxAmountRequired\u001b[0m = \u001b[38;5;82m0.01 USDC\u001b[0m (10,000 micro-USDC)\r\n"]
[0.000, "o", "  \u001b[38;5;117m3.\u001b[0m SDK signs SPL token transfer from wallet \u001b[97mFEuTewmn...gTtk5e\u001b[0m\r\n"]
[0.000, "o", "  \u001b[38;5;117m4.\u001b[0m Transaction broadcast → confirmed on Solana mainnet\r\n"]
[0.000, "o", "  \u001b[38;5;117m5.\u001b[0m Agent retries request with \u001b[97mX-Payment: <tx_signature>\u001b[0m header\r\n"]
[0.000, "o", "  \u001b[38;5;117m6.\u001b[0m Ace Data Cloud verifies on-chain → returns result\r\n"]
[2.012, "o", "\r\n"]
[0.000, "o", "\u001b[38;5;117m\u001b[1m▶ Here's a real x402 transaction — confirmed on Solana mainnet\u001b[0m\r\n"]
