#!/usr/bin/env bash
# Secret-scan staged changes before they enter git history.
#
# Enable once per clone:
#   git config core.hooksPath scripts/hooks
# Requires gitleaks (brew install gitleaks). CI enforces the same scan
# on every PR, so this hook only saves you a red CI run.

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "warning: gitleaks not installed — skipping secret scan (brew install gitleaks)" >&2
  exit 0
fi

exec gitleaks git --staged --redact .
